{
  "expo": {
    "name": "Tape",
    "slug": "tape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#181818",
    "ios": {
      "bundleIdentifier": "com.jakrim.tape",
      "supportsTablet": false
    },
    "android": {
      "package": "com.jakrim.tape",
      "adaptiveIcon": {
        "backgroundColor": "#181818",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181818",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@sentry/react-native",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a28c8d1-fb83-4427-beb7-763ff936560d"
      }
    },
    "owner": "jakrim",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7a28c8d1-fb83-4427-beb7-763ff936560d"
    }
  }
}
