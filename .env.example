# Copy to .env.local for local development. All EXPO_PUBLIC_ values ship inside the app bundle, so none are secrets.

# Privy app (dashboard.privy.io). Without these the app uses an on-device wallet instead.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Supabase. Local values come from `npx supabase@latest start` (API on port 55321).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_KEY=

# Monitoring and analytics. Both are off when unset.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
